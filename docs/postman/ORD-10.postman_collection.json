{
  "info": {
    "name": "Pegasus ORD-10 - Checkout Shipping Quotes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local backend demo. Start the API, seed demo data if needed, and run 01-04 in order. Request 05 creates a real order and reserves inventory. Do not run the whole collection unless you intend to place an order. Defaults use local seed credentials only. Variables are included; no environment import is required. For error demos, use a disposable buyer/cart: inactive or foreign option -> 400 SHIPPING_OPTION_INVALID; no active seller options -> 400 SELLER_SHIPPING_UNAVAILABLE; no buyer address -> 400 SHIPPING_ADDRESS_REQUIRED; foreign address -> 404. Do not share the collection after exporting runtime tokens."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "buyerEmail",
      "value": "buyer@example.com",
      "type": "string"
    },
    {
      "key": "buyerPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "cartItemIds",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "shippingAddressId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shippingOptionBySeller",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "listingId",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Login buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Run first. Saves the buyer access token automatically.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"token\");",
              "pm.collectionVariables.unset(\"shippingAddressId\");",
              "pm.collectionVariables.unset(\"shippingOptionBySeller\");",
              "pm.collectionVariables.unset(\"idempotencyKey\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const token = pm.response.json().data.tokens.accessToken;",
              "  pm.expect(token).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"token\", token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - View buyer cart",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/cart/items",
        "description": "Ensure this buyer has items. Add products through the website using the same account, or use the optional preparation request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart can be read\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Select default shipping address",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/addresses",
        "description": "Automatically selects the default shipping address, or the first address. Set shippingAddressId manually afterwards to select another."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"shippingAddressId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Addresses can be read\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const addresses = pm.response.json().data;",
              "  pm.test(\"Buyer has a shipping address\", () => pm.expect(addresses).to.be.an(\"array\").that.is.not.empty);",
              "  if (Array.isArray(addresses) && addresses.length) {",
              "    const selected = addresses.find(a => a.defaultShipping) || addresses[0];",
              "    pm.collectionVariables.set(\"shippingAddressId\", String(selected.id));",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Shipping quotes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/checkout/shipping-quotes",
        "description": "Empty cartItemIds means the entire buyer cart. Saves each seller's default option and a new checkout idempotency key. This request creates no order and reserves no inventory.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cartItemIds\": {{cartItemIds}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"shippingOptionBySeller\");",
              "pm.collectionVariables.unset(\"idempotencyKey\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Quotes succeed\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const quotes = pm.response.json().data;",
              "  pm.test(\"Quotes contain sellers\", () => pm.expect(quotes).to.be.an(\"array\").that.is.not.empty);",
              "  const choices = {};",
              "  let available = Array.isArray(quotes) && quotes.length > 0;",
              "  for (const q of quotes) {",
              "    pm.test(\"Seller \" + q.sellerProfileId + \" can ship\", () => pm.expect(q.defaultOptionId).to.not.equal(null));",
              "    if (q.defaultOptionId == null) available = false;",
              "    else choices[String(q.sellerProfileId)] = q.defaultOptionId;",
              "  }",
              "  if (available) {",
              "    pm.collectionVariables.set(\"shippingOptionBySeller\", JSON.stringify(choices));",
              "    pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"ord10-{{$guid}}\"));",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Checkout (creates a real order)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/checkout",
        "description": "Creates a real order and reserves inventory. Run 01-04 first. Re-sending uses the same idempotency key and returns the original order. For a new order, replenish the cart and run quote 04 again. Compare each seller order shippingFee with the selected quote option fee.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingAddressId\": {{shippingAddressId}},\n  \"shippingOptionBySeller\": {{shippingOptionBySeller}},\n  \"cartItemIds\": {{cartItemIds}},\n  \"buyerNote\": \"Postman ORD-10 demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"token\", \"shippingAddressId\", \"shippingOptionBySeller\", \"idempotencyKey\"]) {",
              "  if (!pm.collectionVariables.get(key)) throw new Error(\"Missing \" + key + \". Run requests 01-04 successfully first.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order created or idempotently replayed\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional preparation",
      "item": [
        {
          "name": "Optional - Add an existing listing to buyer cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cart/items",
            "description": "Set listingId to a real purchasable listing owned by another seller. Run after login, before requests 02-05. This modifies the buyer cart.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": {{listingId}},\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
