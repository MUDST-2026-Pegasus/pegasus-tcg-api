# Postgres container (compose.yaml)
POSTGRES_DB=pegasus_tcg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# Spring Boot + jOOQ codegen
DB_URL=jdbc:postgresql://localhost:5432/pegasus_tcg
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-48-byte-base64-string
AUTH_DEV_EXPOSE_TOKENS=false

# Browser clients allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000
