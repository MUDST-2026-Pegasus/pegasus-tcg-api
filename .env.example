# Postgres container (compose.yaml)
POSTGRES_DB=pegasus_tcg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# Spring Boot + jOOQ codegen
DB_URL=jdbc:postgresql://localhost:5432/pegasus_tcg
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-48-byte-base64-string
AUTH_DEV_EXPOSE_TOKENS=false
AUTH_REFRESH_COOKIE_SECURE=false
# Lax (default) when web and API share a site; None (needs SECURE=true) when the
# web runs elsewhere, e.g. Cloudflare Worker previews on *.workers.dev.
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
# Login/register/password tries per client address per minute (default 30).
# X-Forwarded-For is only read when the connection comes from a private address
# (the in-cluster ingress); a public caller is counted by its own address.
AUTH_RATE_LIMIT_PER_MINUTE=30
# All /api/v1/** requests per client address per minute, per instance. Must be positive.
API_RATE_LIMIT_PER_MINUTE=300
PROMO_RATE_LIMIT_PER_MINUTE=30
GOOGLE_CLIENT_ID=

# Payments — POST /orders/{id}/pay marks an order paid without taking money.
# Leave false anywhere real; set true only for local work and sandboxes.
PAYMENT_MOCK_ENABLED=false

# Browser clients allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Wildcard origins, e.g. https://*.pegasus-dev-teams.workers.dev (optional)
CORS_ALLOWED_ORIGIN_PATTERNS=

# Object storage (MinIO container in compose.yaml)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=pegasus
# What the app calls. Inside a container this becomes http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
# What the browser calls; presigned URLs are signed for this host.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# PromptPay QR
PROMPTPAY_TYPE=PHONE
PROMPTPAY_TARGET=08XXXXXXXX
PROMPTPAY_BANK=
PROMPTPAY_NAME=PEGASUS TCG
# Observability (OpenTelemetry traces & metrics / Structured logging)
APP_ENV=local
APP_VERSION=dev
# Empty keeps readable console output locally; set to "logstash" for JSON logs.
LOG_FORMAT=
# OTLP/HTTP endpoints for Grafana Alloy / OpenTelemetry Collector over NetBird.
OTLP_TRACING_ENDPOINT=http://100.86.180.113:4318/v1/traces
OTLP_METRICS_ENDPOINT=http://100.86.180.113:4318/v1/metrics
OTLP_METRICS_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
